@* Shows what Verify concluded, keeping the BR codes visible: they are what a support query to
   ANAF, or a search of the CIUS-RO specification, actually needs. *@

<div class="mt-3">
    <h2 class="h5">@Heading</h2>

    @if (Report.IsValid)
    {
        <div class="alert alert-success mb-0">
            Valid. ANAF will not reject this document for format reasons.
            @if (Report.Warnings.Any())
            {
                <span>There @(Report.Warnings.Count() == 1 ? "is" : "are") @Report.Warnings.Count() warning(s) below.</span>
            }
        </div>
    }
    else
    {
        <div class="alert alert-danger mb-2">
            @Report.Errors.Count() problem(s) would cause ANAF to reject this document.
        </div>
    }

    @if (Report.Findings.Count > 0)
    {
        <table class="table table-sm">
            <thead>
                <tr><th>Rule</th><th>Where</th><th>What is wrong</th></tr>
            </thead>
            <tbody>
                @foreach (var finding in Report.Findings)
                {
                    <tr class="@(finding.Severity == ValidationSeverity.Error ? "table-danger" : "table-warning")">
                        <td><code>@finding.Code</code></td>
                        <td><code>@(finding.Path ?? "—")</code></td>
                        <td>@finding.Message</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    /// <summary>The report to display.</summary>
    [Parameter, EditorRequired]
    public ValidationReport Report { get; set; } = ValidationReport.Valid;

    /// <summary>Heading above the table.</summary>
    [Parameter]
    public string Heading { get; set; } = "Validation";
}
