<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RomaniaEFactura</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- NuGet package. Note: no GeneratePackageOnBuild and no PackageOutputPath -
       v2 packed on every build into a hardcoded D:\ path that broke on any other machine. -->
  <PropertyGroup>
    <PackageId>RomaniaEFacturaLibrary</PackageId>
    <Version>3.0.0-alpha.1</Version>
    <Authors>lucianbumb</Authors>
    <Description>
      Romanian e-Factura (ANAF SPV) integration for .NET web applications. Offline CIUS-RO
      validation, UBL invoice/credit note/debit note generation, OAuth2 with persistent token
      storage, and the full send and download lifecycle.
    </Description>
    <PackageTags>efactura;romania;anaf;spv;ubl;en16931;cius-ro;invoice;oauth2</PackageTags>
    <PackageProjectUrl>https://github.com/lucianbumb/RomaniaEFacturaSolution</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lucianbumb/RomaniaEFacturaSolution.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- The envelope reader is internal because nothing outside the transport should be deciding
       whether an ANAF response succeeded, but it needs testing directly against real bodies. -->
  <!-- The library ships the OAuth connect and callback endpoints, so it needs the ASP.NET
       framework. That is a deliberate consequence of targeting web applications: the callback is
       easy to get subtly wrong, and leaving it to each consumer invites CSRF and open-redirect
       bugs. What must NOT happen - and does not - is HttpContext appearing in the token store
       contract, which is what made the previous version unusable from background jobs. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RomaniaEFactura.Tests" />
    <InternalsVisibleTo Include="RomaniaEFactura.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RomaniaEFactura.Abstractions\RomaniaEFactura.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
  </ItemGroup>

</Project>
